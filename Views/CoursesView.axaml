<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WestCoastEducation.ViewModels"
             xmlns:m="using:WestCoastEducation.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
             x:Class="WestCoastEducation.Views.CoursesView"
             x:DataType="vm:CoursesViewModel">

    <Grid Margin="20">
        <Grid RowDefinitions="Auto, *, Auto, Auto" 
              IsVisible="{Binding CurrentCourseView, Converter={x:Static ObjectConverters.IsNull}}">
            
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Administrera Kurser" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                <Button Content="+ Lägg till ny kurs" Command="{Binding ShowAddFormCommand}" Background="{DynamicResource ThirdTextBrush}" Foreground="{DynamicResource ForegroundBrush}" Margin="20,0,0,0"/>
            </StackPanel>
            
            <ListBox Grid.Row="1" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" Margin="0,15">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="m:Course">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <TextBlock Text="{Binding CourseNumber}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding Title}"/>
                            <TextBlock Text="{Binding DurationInWeeks}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="veckor" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>            
        </Grid>

        <ContentControl Content="{Binding CurrentCourseView}" 
                        IsVisible="{Binding CurrentCourseView, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    </Grid>
</UserControl>