<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WestCoastEducation.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="650"
             x:Class="WestCoastEducation.Views.AddTeacherView"
             x:DataType="vm:AddTeacherViewModel">

    <StackPanel Margin="30" Spacing="10" MaxWidth="450">
        <TextBlock Text="Registrera ny lärare" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        
        <TextBox PlaceholderText="Förnamn" Text="{Binding FirstName}" />
        <TextBox PlaceholderText="Efternamn" Text="{Binding LastName}" />
        <TextBox PlaceholderText="Personnummer" Text="{Binding PersonalNumber}" />
        <TextBox PlaceholderText="Telefonnummer (tal)" Text="{Binding PhoneNumber}" />
        <TextBox PlaceholderText="Adress" Text="{Binding Address}" />
        <TextBox PlaceholderText="Postnummer (tal)" Text="{Binding PostalCode}" />
        <TextBox PlaceholderText="Region" Text="{Binding Region}" />
        <TextBox PlaceholderText="Ämnesområde (Subject Area)" Text="{Binding SubjectArea}" />
        
        <Button Content="Spara lärare" Command="{Binding SaveTeacherCommand}" Background="{DynamicResource ThirdTextBrush}" Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>