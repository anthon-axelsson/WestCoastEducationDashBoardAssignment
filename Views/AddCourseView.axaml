<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WestCoastEducation.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
             x:Class="WestCoastEducation.Views.AddCourseView"
             x:DataType="vm:AddCourseViewModel">

    <StackPanel Margin="30" Spacing="12" MaxWidth="450">
        <TextBlock Text="Registrera ny kurs" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
        
        <TextBox PlaceholderText="Kursnummer (t.ex. C#101)" Text="{Binding CourseNumber}" />
        <TextBox PlaceholderText="Kurstitel" Text="{Binding Title}" />
        <TextBox PlaceholderText="Antal veckor (tal)" Text="{Binding DurationInWeeks}" />
        
        <TextBlock Text="Startdatum:" Foreground="#94A3B8" Margin="0,5,0,0"/>
        <DatePicker SelectedDate="{Binding StartDate}" HorizontalAlignment="Stretch"/>
        
        <TextBlock Text="Slutdatum:" Foreground="#94A3B8" Margin="0,5,0,0"/>
        <DatePicker SelectedDate="{Binding EndDate}" HorizontalAlignment="Stretch"/>

        <TextBlock Text="{Binding StatusMessage}" Foreground="#34D399" Margin="0,5,0,0"/>
        
        <Button Content="Spara kurs" Command="{Binding SaveCourseCommand}" Background="#10B981" Foreground="White" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>