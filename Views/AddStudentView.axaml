<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WestCoastEducation.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             x:Class="WestCoastEducation.Views.AddStudentView"
             x:DataType="vm:AddStudentViewModel">

    <StackPanel Margin="30" Spacing="15" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Registrera ny student" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
        
        <TextBox PlaceholderText="Förnamn" Text="{Binding FirstName}" />
        <TextBox PlaceholderText="Efternamn" Text="{Binding LastName}" />
        <TextBox PlaceholderText="Personnummer" Text="{Binding PersonalNumber}" />
        <TextBox PlaceholderText="Telefonnummer" Text="{Binding PhoneNumber}" />
        <TextBox PlaceholderText="Adress" Text="{Binding Address}" />
        <TextBox PlaceholderText="Postnummer" Text="{Binding PostalCode}" />
        <TextBox PlaceholderText="Region" Text="{Binding Region}" />

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
            <Button Content="Spara student" Command="{Binding SaveStudentCommand}" Background="{DynamicResource ThirdTextBrush}" Foreground="{DynamicResource ForegroundBrush}" Padding="15,8"/>
        </StackPanel>
    </StackPanel>
</UserControl>